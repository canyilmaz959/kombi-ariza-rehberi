<!DOCTYPE html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Arama sonuçları | Arıza Rehberi</title><link rel="stylesheet" href="/styles.css"></head><body><header class="site-header"><div class="shell nav"><a class="brand" href="/"><span class="brand-mark">A</span><span>Arıza Rehberi</span></a><nav class="nav-links"><a href="/tum-markalar">Markalar</a><a href="/tum-modeller">Modeller</a><a href="/tum-arizalar">Hata kodları</a></nav></div></header><main class="shell"><p class="eyebrow">Arama</p><h1>“<%= q %>” sonuçları</h1><form class="search-form" action="/arama" method="GET"><input type="search" name="q" value="<%= q %>" maxlength="100"><button type="submit">Yeniden ara</button></form><% if(arizalar.length === 0 && markalar.length === 0 && modeller.length === 0) { %><div class="empty" style="margin-top:30px">Bu aramayla eşleşen kayıt bulunamadı.</div><% } %><% if(arizalar.length) { %><section><div class="section-head"><div><p class="eyebrow">Arızalar</p><h2>Hata kodları</h2></div></div><div class="list"><% arizalar.forEach(ariza => { %><a class="list-item" href="/markalar/<%= ariza.marka.slug %>/<%= ariza.model.slug %>/<%= ariza.kod %>"><span><strong><%= ariza.kod %></strong><br><span style="color:var(--muted)"><%= ariza.baslik || 'Detayları görüntüle' %></span></span><span class="badge"><%= ariza.model.name %></span></a><% }); %></div></section><% } %><% if(markalar.length) { %><section><div class="section-head"><div><p class="eyebrow">Markalar</p><h2>Marka eşleşmeleri</h2></div></div><div class="card-grid"><% markalar.forEach(marka => { %><a class="card" href="/markalar/<%= marka.slug %>"><span class="card-label">Marka</span><h3><%= marka.name %></h3></a><% }); %></div></section><% } %><% if(modeller.length) { %><section><div class="section-head"><div><p class="eyebrow">Modeller</p><h2>Model eşleşmeleri</h2></div></div><div class="list"><% modeller.forEach(model => { %><a class="list-item" href="/markalar/<%= model.marka.slug %>/<%= model.slug %>"><span><strong><%= model.name %></strong><br><span style="color:var(--muted)"><%= model.marka.name %></span></span><span>→</span></a><% }); %></div></section><% } %></main></body></html>
