<!DOCTYPE html>
<html>
<head>
  <title>Tüm Kombi Arızaları</title>
</head>
<body>

    <h1>Tüm Kombi Arızaları</h1>

    <ul>
        <% if(arizalar.length === 0){ %>
            <li>Henüz arıza eklenmemiş.</li>
        <% } %>
        <% arizalar.forEach(function(ariza){ %>
            <li>
                <a href="/arizalar/<%= ariza._id %>">
                    <%= ariza.kod %> - <%= ariza.baslik %> (<%= ariza.marka ? ariza.marka.name : "Genel" %> - <%= ariza.model ? ariza.model.name : "Genel" %>)
                </a>
            </li>
        <% }) %>

    </ul>

    <% if (toplamSayfa > 1) { %>
  <div>
    <% if (mevcutSayfa > 1) { %>
      <a href="?sayfa=<%= mevcutSayfa - 1 %>">← Önceki</a>
    <% } %>

    <% for (let i = 1; i <= toplamSayfa; i++) { %>
      <% if (i === mevcutSayfa) { %>
        <strong>[<%= i %>]</strong>
      <% } else { %>
        <a href="?sayfa=<%= i %>"><%= i %></a>
      <% } %>
    <% } %>

    <% if (mevcutSayfa < toplamSayfa) { %>
      <a href="?sayfa=<%= mevcutSayfa + 1 %>">Sonraki →</a>
    <% } %>
  </div>
<% } %>

</body>
</html>