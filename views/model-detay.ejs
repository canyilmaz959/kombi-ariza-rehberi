<!DOCTYPE html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= marka.name %> <%= model.name %> hata kodları | Arıza Rehberi</title><link rel="stylesheet" href="/styles.css"></head><body><header class="site-header"><div class="shell nav"><a class="brand" href="/"><span class="brand-mark">A</span><span>Arıza Rehberi</span></a><nav class="nav-links"><a href="/tum-markalar">Markalar</a><a href="/tum-modeller">Modeller</a><a href="/tum-arizalar">Hata kodları</a></nav></div></header><main class="shell"><p class="breadcrumb"><a href="/">Ana sayfa</a> / <a href="/markalar/<%= marka.slug %>"><%= marka.name %></a> / <%= model.name %></p><section class="detail-head"><p class="eyebrow"><%= marka.name %> · Model</p><h1><%= model.name %> hata kodları</h1></section><section style="margin-top:35px"><div class="section-head"><div><p class="eyebrow">Arıza kataloğu</p><h2>Hata kodları</h2></div></div><% if(arizalar.length === 0){ %><div class="empty">Bu model için henüz arıza kodu eklenmemiş.</div><% } else { %><div class="list"><% arizalar.forEach(function(ariza){ %><a class="list-item" href="/markalar/<%= marka.slug %>/<%= model.slug %>/<%= ariza.kod %>"><span><strong><%= ariza.kod %></strong><br><span style="color:var(--muted)"><%= ariza.baslik || 'Hata detayını aç' %></span></span><span>→</span></a><% }) %></div><% } %></section></main></body></html>
