<!DOCTYPE html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Arıza listesi | Admin</title><link rel="stylesheet" href="/styles.css"></head><body><header class="site-header"><div class="admin-shell nav"><a class="brand" href="/admin"><span class="brand-mark">A</span><span>Arıza Rehberi <small style="color:var(--muted)">/ Yönetim</small></span></a><nav class="nav-links"><a href="/admin">Panel</a><a href="/admin-logout">Çıkış</a></nav></div></header><main class="admin-shell"><section class="admin-header"><div><p class="eyebrow">İçerik yönetimi</p><h1>Arıza kayıtları</h1></div><a class="button" href="/admin">Yeni kayıt ekle</a></section><section class="admin-card"><% if (arizalar.length === 0) { %><div class="empty">Henüz arıza eklenmedi.</div><% } else { %><div class="table-list"><% arizalar.forEach(function(ariza){ %><div class="admin-row"><div><strong><%= ariza.kod %></strong><small><%= ariza.marka.name %> · <%= ariza.model.name %></small><small><%= ariza.baslik || 'Başlık eklenmemiş' %></small></div><div class="inline-actions"><a class="button ghost" href="/admin/ariza-duzenle/<%= ariza._id %>">Düzenle</a><form action="/admin/admin-arizalar/<%= ariza._id %>" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Sil</button></form></div></div><% }) %></div><% } %></section></main></body></html>
