<!DOCTYPE html>
<html>
<head>
  <title>Kombi Markaları</title>
</head>
<body>

    <h1>Tüm Kombi Markaları</h1>

    <ul>
        <% if(markalar.length === 0){ %>
            <li>Henüz marka eklenmemiş.</li>
        <% } %>

        <% markalar.forEach(function(marka){ %>
            <li>
                <a href="/markalar/<%= marka.slug %>">
                    <%= marka.name.toUpperCase() %>
                </a>
            </li>
        <% }) %>
    </ul>

    <% if (toplamSayfa > 1) { %>
  <div>
    <% if (mevcutSayfa > 1) { %>
      <a href="?sayfa=<%= mevcutSayfa - 1 %>">← Önceki</a>
    <% } %>

    <% for (let i = 1; i <= toplamSayfa; i++) { %>
      <% if (i === mevcutSayfa) { %>
        <strong>[<%= i %>]</strong>
      <% } else { %>
        <a href="?sayfa=<%= i %>"><%= i %></a>
      <% } %>
    <% } %>

    <% if (mevcutSayfa < toplamSayfa) { %>
      <a href="?sayfa=<%= mevcutSayfa + 1 %>">Sonraki →</a>
    <% } %>
  </div>
<% } %>
 

</body>
</html>