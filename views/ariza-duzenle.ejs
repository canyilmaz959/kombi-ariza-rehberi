<!DOCTYPE html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Arıza düzenle | Admin</title><link rel="stylesheet" href="/styles.css"></head><body><header class="site-header"><div class="admin-shell nav"><a class="brand" href="/admin"><span class="brand-mark">A</span><span>Arıza Rehberi <small style="color:var(--muted)">/ Yönetim</small></span></a><nav class="nav-links"><a href="/admin/admin-arizalar">Liste</a><a href="/admin-logout">Çıkış</a></nav></div></header><main class="admin-shell"><section class="admin-header"><div><p class="eyebrow">Teknik içerik</p><h1>Arıza düzenle</h1><p class="lede"><%= ariza.kod %> kodlu kaydı güncelliyorsun.</p></div></section><section class="admin-card"><form action="/admin/ariza-duzenle/<%= ariza._id %>" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div class="field full"><label for="baslik">Başlık</label><input id="baslik" type="text" name="baslik" value="<%= ariza.baslik || '' %>"></div><div class="field full"><label for="aciklama">Açıklama</label><textarea id="aciklama" name="aciklama"><%= ariza.aciklama || '' %></textarea></div><div class="field full"><label for="cozum">Çözüm</label><textarea id="cozum" name="cozum"><%= ariza.cozum || '' %></textarea></div></div><div class="form-actions"><button type="submit">Değişiklikleri kaydet</button><a class="button ghost" href="/admin/admin-arizalar">Vazgeç</a></div></form></section></main></body></html>
