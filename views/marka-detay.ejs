<!DOCTYPE html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= marka.name %> modelleri | Arıza Rehberi</title><link rel="stylesheet" href="/styles.css"></head><body><header class="site-header"><div class="shell nav"><a class="brand" href="/"><span class="brand-mark">A</span><span>Arıza Rehberi</span></a><nav class="nav-links"><a href="/tum-markalar">Markalar</a><a href="/tum-modeller">Modeller</a><a href="/tum-arizalar">Hata kodları</a></nav></div></header><main class="shell"><p class="breadcrumb"><a href="/">Ana sayfa</a> / Markalar</p><section class="detail-head"><p class="eyebrow">Marka</p><h1><%= marka.name %> kombi modelleri</h1></section><section style="margin-top:35px"><div class="section-head"><div><p class="eyebrow">Cihaz seçimi</p><h2>Modeller</h2></div></div><% if(modeller.length === 0){ %><div class="empty">Bu markaya ait model henüz eklenmemiş.</div><% } else { %><div class="card-grid"><% modeller.forEach(function(model){ %><a class="card" href="/markalar/<%= marka.slug %>/<%= model.slug %>"><span class="card-label">Model</span><h3><%= model.name %></h3><p>Hata kodlarını incele →</p></a><% }) %></div><% } %></section></main></body></html>
