<!DOCTYPE html>
<html>
<head>
  <title>Kombi Hata Kodları ve Çözümleri | Tüm Markalar</title>
</head>
<body>

<form action="/arama" method="GET">
    <input type="text" name="q" placeholder="Model, marka veya hata kodu ara...">
    <button type="submit">Ara</button>
</form>

<h1>Tüm Kombi Markaları İçin Hata Kodları Rehberi</h1><br><br>
<h2>Kombi Markaları</h2>

<ul>
  <% if(markalar.length === 0){ %>
    <li>Henüz marka eklenmemiş.</li>
  <% } %>

  <% markalar.forEach(function(marka){ %>
    <li>
      <a href="/markalar/<%= marka.slug %>">
        <%= marka.name.toUpperCase() %>
      </a>
    </li>
  <% }) %>
</ul>

</body>
</html>
