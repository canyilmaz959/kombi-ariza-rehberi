<!DOCTYPE html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin paneli | Arıza Rehberi</title><link rel="stylesheet" href="/styles.css"></head><body><header class="site-header"><div class="admin-shell nav"><a class="brand" href="/"><span class="brand-mark">A</span><span>Arıza Rehberi <small style="color:var(--muted)">/ Yönetim</small></span></a><nav class="nav-links"><a href="/admin/admin-arizalar">Arıza listesi</a><a href="/admin-logout">Çıkış</a></nav></div></header><main class="admin-shell"><section class="admin-header"><div><p class="eyebrow">İçerik yönetimi</p><h1>Admin paneli</h1></div><a class="button secondary" href="/">Siteyi görüntüle →</a></section><div class="admin-grid"><section class="admin-card"><p class="eyebrow">01 · Katalog</p><h2>Marka ekle</h2><form action="/marka-ekle" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label for="brand-name">Marka adı</label><input id="brand-name" type="text" name="name" placeholder="Örn. Vaillant" required></div><div class="form-actions"><button type="submit">Marka ekle</button></div></form></section><section class="admin-card"><p class="eyebrow">02 · Katalog</p><h2>Model ekle</h2><form action="/model-ekle" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div class="field"><label for="model-name">Model adı</label><input id="model-name" type="text" name="name" placeholder="Örn. ecoTEC Plus" required></div><div class="field"><label for="model-brand">Marka</label><select id="model-brand" name="marka" required><option value="">Marka seç</option><% markalar.forEach(function(marka){ %><option value="<%= marka._id %>"><%= marka.name %></option><% }) %></select></div></div><div class="form-actions"><button type="submit">Model ekle</button></div></form></section><section class="admin-card wide"><p class="eyebrow">03 · Teknik içerik</p><h2>Arıza kaydı oluştur</h2><form action="/admin" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div class="field"><label for="markaSelect">Marka</label><select name="marka" id="markaSelect" required><option value="">Marka seç</option><% markalar.forEach(function(marka){ %><option value="<%= marka._id %>"><%= marka.name %></option><% }) %></select></div><div class="field"><label for="modelSelect">Model</label><select name="model" id="modelSelect" required disabled><option value="">Önce marka seç</option><% modeller.forEach(function(m){ %><option value="<%= m._id %>" data-marka="<%= m.marka %>"><%= m.name %></option><% }) %></select></div><div class="field"><label for="kod">Hata kodu</label><input id="kod" type="text" name="kod" placeholder="Örn. F28" required></div><div class="field"><label for="baslik">Kısa başlık</label><input id="baslik" type="text" name="baslik" placeholder="Örn. Ateşleme arızası"></div><div class="field full"><label for="aciklama">Açıklama</label><textarea name="aciklama" id="aciklama" placeholder="Arızanın ne anlama geldiğini anlat..."></textarea></div><div class="field full"><label for="cozum">Çözüm önerisi</label><textarea name="cozum" id="cozum" placeholder="Kullanıcıya önerilecek adımları yaz..."></textarea></div></div><div class="form-actions"><button type="submit">Arıza ekle</button></div></form></section><section class="admin-card"><p class="eyebrow">Bakım</p><h2>Kayıtları yönet</h2><p class="lede">Eklenmiş arızaları düzenle veya kaldır.</p><a class="button ghost" href="/admin/admin-arizalar">Arıza listesine git →</a></section><section class="admin-card"><p class="eyebrow">Dikkat</p><h2>Silme işlemleri</h2><p class="lede">Marka silmek, ona bağlı model ve arıza kayıtlarını da kaldırır.</p><form action="/marka-sil" method="POST" class="form-actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="markaId" required><option value="">Marka seç</option><% markalar.forEach(function(marka){ %><option value="<%= marka._id %>"><%= marka.name %></option><% }) %></select><button type="submit">Markayı sil</button></form><form action="/model-sil" method="POST" class="form-actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="modelId" required><option value="">Model seç</option><% modeller.forEach(function(m){ %><option value="<%= m._id %>"><%= m.name %></option><% }) %></select><button type="submit">Modeli sil</button></form></section></div></main><script>const markaSelect=document.getElementById('markaSelect');const modelSelect=document.getElementById('modelSelect');function filtrele(){const mid=markaSelect.value;modelSelect.disabled=!mid;Array.from(modelSelect.options).forEach(opt=>{if(opt.value==='')return;opt.hidden=opt.dataset.marka!==mid;});if(!mid)modelSelect.value='';}markaSelect.addEventListener('change',filtrele);filtrele();</script></body></html>
