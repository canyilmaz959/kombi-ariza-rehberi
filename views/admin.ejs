<h1>Admin Paneli</h1>

<h2>Marka Ekle</h2>
<form action="/marka-ekle" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="text" name="name" placeholder="Marka adı" required>
    <button type="submit">Marka Ekle</button>
</form>

<hr>

<h2>Model Ekle</h2>
<form action="/model-ekle" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="text" name="name" placeholder="Model adı" required>
    <select name="marka" required>
        <option value="">Marka Seç</option>
        <% markalar.forEach(function(marka){ %>
            <option value="<%= marka._id %>"><%= marka.name %></option>
        <% }) %>
    </select>
    <button type="submit">Model Ekle</button>
</form>

<hr>

<h2>Arıza Ekle</h2>
<form action="/admin" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label>Marka Seç:</label><br>
    <select name="marka" id="markaSelect" required>
        
        <option value="">Marka Seç</option>
        <% markalar.forEach(function(marka){ %>
            <option value="<%= marka._id %>">
                <%= marka.name %>
            </option>
        <% }) %>
    </select>
    <br><br>

    <label>Model Seç:</label><br>
    <select name="model" id="modelSelect" required disabled>
        <option value="">Model Seç</option>
        <% modeller.forEach(function(m){ %>
            <option value="<%= m._id %>" data-marka="<%= m.marka %>">
                <%= m.name %>
            </option>
        <% }) %>
    </select>
    <br><br>

    <input type="text" name="kod" placeholder="Kod" required><br><br>

</form>

<h2>marka silme</h2>
<form action="/marka-sil" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <select name="markaId" required>
        <option value="">Marka Seç</option>
        <% markalar.forEach(function(marka){ %>
            <option value="<%= marka._id %>"><%= marka.name %></option>
        <% }) %>
    </select>
    <button type="submit">Marka Sil</button>
</form>

<h2>Model Silme</h2>
<form action="/model-sil" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <select name="modelId" required>
        <option value="">Model Seç</option>
        <% modeller.forEach(function(m){ %>
            <option value="<%= m._id %>"><%= m.name %></option>
        <% }) %>
    </select>
    <button type="submit">Model Sil</button>
</form>

<h2>Arıza Listesi Sayfası</h2>
<strong>eklenen arızaların listesine gider</strong>
<button><a href='/admin/admin-arizalar'>Arıza Listesi</a></button>

<button><a href="/">Ana Sayfa</a></button>

<script>
// marka seçimi değiştikçe ilgili modelleri göster
const markaSelect = document.getElementById('markaSelect');
const modelSelect = document.getElementById('modelSelect');
function filtrele(){
    const mid = markaSelect.value;

    modelSelect.disabled = !mid; // marka seçilmemişse modeli de seçilemez yapalım

    Array.from(modelSelect.options).forEach(opt =>{
        if (opt.value === ""){
            opt.style.display = "";
            return; 
        }

        opt.style.display = opt.dataset.marka === mid ? "" : "none";
    });
    modelSelect.value = "";
}

markaSelect.addEventListener('change', filtrele);

filtrele(); // sayfa yüklendiğinde de çalıştırarak doğru modelleri gösterelim

</script>
