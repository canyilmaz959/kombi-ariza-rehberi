<!DOCTYPE html>
<html>
<head>
  <title>Tüm Kombi Modelleri</title>
</head>
<body>

    <h1>Tüm Kombi Modelleri</h1>

    <ul>
        <% if(modeller.length === 0){ %>
            <li>Henüz model eklenmemiş.</li>
        <% } %>
        <% modeller.forEach(function(model){ %>
            <li>
                <a href="/markalar/<%= model.marka.slug %>/modeller/<%= model.slug %>">
                    <%= model.name %> (<%= model.marka ? model.marka.name : "Genel" %>)
                </a>
            </li>
        <% }) %>

    </ul>


    <% if (toplamSayfa > 1) { %>
  <div>
    <% if (mevcutSayfa > 1) { %>
      <a href="?sayfa=<%= mevcutSayfa - 1 %>">← Önceki</a>
    <% } %>

    <% for (let i = 1; i <= toplamSayfa; i++) { %>
      <% if (i === mevcutSayfa) { %>
        <strong>[<%= i %>]</strong>
      <% } else { %>
        <a href="?sayfa=<%= i %>"><%= i %></a>
      <% } %>
    <% } %>

    <% if (mevcutSayfa < toplamSayfa) { %>
      <a href="?sayfa=<%= mevcutSayfa + 1 %>">Sonraki →</a>
    <% } %>
  </div>
<% } %>
</body>
</html>